.menu-item {
    display: flex;
    flex-direction: row;
    min-width: 10px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/OpenSans-Light.ttf?fileID=12800000&guid=d9dffe1eb66f6b14b95fdff9609adf7c&type=3#OpenSans-Light");
    -unity-text-align: middle-center;
    width: auto;
    margin-top: 5px;
    margin-bottom: 5px;
    margin-right: 5px;
    margin-left: 5px;
}

.keyboard-key {
    background-color: darkgray;
    width: auto;
    height: auto;
    align-self: center;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-color: rgb(43, 43, 43);
    border-radius: 5px;
    -unity-text-align: middle-center;
    white-space: normal;
    text-overflow: clip;
    margin-left: 10px;
    align-content: center;
    min-width: 15px;
    min-height: 15px;
    margin-right: 0;
    justify-content: center;
    align-items: center;
}

.promt-font-key {
    -unity-font-definition: url("project://database/Assets/UI/Fonts/promptfont.ttf?fileID=12800000&guid=786e752106593ae4da07d2e2f13225eb&type=3#promptfont");
    padding-left: 0;
    -unity-text-align: middle-center;
    width: 15px;
    height: 15px;
    align-self: center;
    margin-right: 0;
    margin-left: 10px;
}

.crosshair {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 8px;
    height: 8px;
    transition-property: border-width, border-color, background-color;
    transition-duration: 0.5s;
    transition-timing-function: ease;
    background-color: transparent;
    border-color: white;
    border-width: 1px;
    border-radius: 50%;
    opacity: 0.8;
    translate: -4px -4px;
}

.crosshair--interactive {
    border-color: black;
    border-width: 1px;
    background-color: white;
    width: 8px;
    height: 8px;
    transition-property: border-width, border-color, background-color;
    transition-duration: 0.5s;
    transition-timing-function: ease;
}

.player-ui-container {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/OpenSans-Light%20SDF.asset?fileID=11400000&guid=9e566c4120afe0349963b11beb47b5f4&type=2#OpenSans-Light SDF");
    position: absolute;
}

.status-bar {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 30px;
    min-height: auto;
    background-color: rgba(15, 15, 20, 0.85);
    border-width: 1px;
    border-color: rgba(80, 80, 90, 0.4);
    border-radius: 4px;
    padding: 8px 0;
    transition-property: background-color, border-color, opacity;
    transition-duration: 0.4s;
    transition-timing-function: ease-in-out;
    opacity: 0.9;
}

.status-icons {
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
    height: 100%;
}

.status-icon {
    width: 20px;
    height: 20px;
    margin-bottom: 6px;
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.7;
    transition-property: opacity, transform;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
    display: none;
}

.status-icon--active {
    display: flex;
    opacity: 0.9;
}

.chapter-popup {
    position: absolute;
    top: 15%;
    left: 51%;
    translate: -50% 0;
    width: 250px;
    height: 80px;
    opacity: 0;
    transition-property: opacity, transform;
    transition-duration: 0.8s;
    transition-timing-function: ease-out;
    background-color: rgba(8, 8, 12, 0.9);
}

.chapter-border {
    width: 100%;
    height: 100%;
    border-width: 2px;
    border-color: rgba(180, 180, 190, 0.2);
    border-radius: 1px;
    padding: 20px;
    justify-content: center;
    align-items: center;
    flex-direction: column;
}

.chapter-number {
    font-size: 36px;
    color: rgba(220, 220, 230, 0.8);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 0;
    letter-spacing: 2px;
    text-shadow: 0 0 8px rgba(220, 220, 230, 0.3);
}

.chapter-divider {
    width: 60px;
    height: 1px;
    background-color: rgba(180, 180, 190, 0.4);
    margin-bottom: 8px;
}

.chapter-title {
    font-size: 16px;
    color: rgba(200, 200, 210, 0.9);
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    letter-spacing: 3px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/OpenSans-Light.ttf?fileID=12800000&guid=d9dffe1eb66f6b14b95fdff9609adf7c&type=3#OpenSans-Light");
}

.interactable-interactions {
    align-items: flex-end;
    flex-grow: 1;
    justify-content: flex-end;
}
