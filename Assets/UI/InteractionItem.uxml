<engine:UXML xmlns:engine="UnityEngine.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/PlayerUIStyles.uss?fileID=7433441132597879392&amp;guid=48edef120b2c4034ab539c043d9d571d&amp;type=3#PlayerUIStyles" />
    <engine:VisualElement name="InteractionItem" class="menu-item">
        <engine:Label name="action-name" text="Shoot" class="action-text" />
        <engine:VisualElement name="KeyContainer" class="keyboard-key">
            <engine:Label name="key-text" enable-rich-text="false" text="F" class="key-hint-text" style="-unity-text-align: middle-center; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; font-size: 18px;" />
            <Bindings>
                <engine:DataBinding property="display" binding-path="IsIcon" binding-mode="ToTarget" binding-condition="Inverse" />
            </Bindings>
        </engine:VisualElement>
        <engine:VisualElement name="IconContainer" class="promt-font-key" style="flex-grow: 0; min-width: 30px; min-height: 30px;">
            <engine:Label text="⇓" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 18%; padding-left: 0; -unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/promptfont%20SDF.asset?fileID=11400000&amp;guid=d3fed19fb13b9ae4abaf9aee6693c443&amp;type=2#promptfont SDF&quot;); font-size: 40px; color: rgb(0, 0, 0); -unity-text-align: middle-center;" />
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
